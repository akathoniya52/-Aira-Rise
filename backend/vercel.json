{
  "version": 2,
  "name": "airarise-backend",
  "description": "AiraRise Express API deployed on Vercel as serverless functions",
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
